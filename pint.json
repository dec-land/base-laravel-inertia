{
  "preset": "laravel",
  "rules": {
    "declare_strict_types": {
      "preserve_existing_declaration": false
    },
    "strict_comparison": true,
    "strict_param": true,
    "global_namespace_import": {
      "import_classes": true,
      "import_constants": true,
      "import_functions": true
    },
    "phpdoc_align": {
      "align": "left"
    },
    "class_attributes_separation": {
      "elements": {
        "const": "one",
        "method": "one",
        "property": "one",
        "trait_import": "none"
      }
    },
    "mb_str_functions": true
  }
}