{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "fubball/backend",
  "type": "project",
  "description": "The backend for Hatch.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "fakerphp/faker": "^1.23",
    "inertiajs/inertia-laravel": "^3.1.0",
    "laravel/ai": "^0.10",
    "laravel/framework": "^13",
    "laravel/nightwatch": "^1.21",
    "laravel/octane": "^2.17",
    "laravel/reverb": "^1.0",
    "laravel/socialite": "^5.27",
    "laravel/tinker": "^3",
    "resend/resend-laravel": "^1.5",
    "socialiteproviders/discord": "^4.2",
    "spatie/laravel-data": "^4.23",
    "spatie/laravel-query-builder": "^7.3",
    "spatie/laravel-settings": "^3.9",
    "spatie/laravel-sitemap": "^8.1",
    "spatie/laravel-typescript-transformer": "^3.2",
    "symfony/http-client": "^8.1",
    "symfony/mailgun-mailer": "^8.1",
    "tightenco/ziggy": "^2.6"
  },
  "require-dev": {
    "brianium/paratest": "^7.20",
    "driftingly/rector-laravel": "^2.0",
    "larastan/larastan": "^3.10.0",
    "laravel/boost": "^2.4",
    "laravel/pint": "^1.29",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpstan/phpstan": "^2.2.2",
    "phpunit/phpunit": "^13",
    "rector/rector": "^2.0",
    "spatie/phpunit-snapshot-assertions": "^5.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "pint": [
      "vendor/bin/pint"
    ],
    "static-analysis": [
      "vendor/bin/phpstan analyse --memory-limit=2G"
    ],
    "static-analysis-generate": [
      "vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline"
    ],
    "rector-dry-run": [
      "vendor/bin/rector process --dry-run"
    ],
    "rector": [
      "vendor/bin/rector process"
    ],
    "coverage": [
      "vendor/bin/sail test --coverage-clover=coverage.xml --coverage-html=public/coverage-report"
    ],
    "test": [
      "vendor/bin/sail test --parallel"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "pixelfear/composer-dist-plugin": true,
      "tbachert/spi": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
